COSXIA_DB_NAME=cosxia
COSXIA_DB_USER=postgres
COSXIA_DB_PASSWORD=replace-with-local-password
COSXIA_DB_HOST=127.0.0.1
COSXIA_DB_PORT=5432
COSXIA_OLLAMA_URL=http://127.0.0.1:11434/api/generate
COSXIA_OLLAMA_MODEL=mistral:latest
COSXIA_OLLAMA_TIMEOUT=120
# Set to true only to use the deterministic scanner instead of Ollama.
COSXIA_ALLOW_DETERMINISTIC_FALLBACK=false
